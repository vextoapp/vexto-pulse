# Vexto Pulse checker: one run checks every app, then exits. Started by vexto-pulse-checker.timer.
[Unit]
Description=Vexto Pulse checker (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/vexto-pulse
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/checker.js
TimeoutStartSec=90
MemoryMax=100M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pi/vexto-pulse/data
PrivateTmp=true
