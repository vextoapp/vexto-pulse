{
  "name": "vexto-pulse",
  "version": "1.0.0",
  "description": "Uptime monitor and public status page for the vexto.app portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "check": "node --disable-warning=ExperimentalWarning dist/checker.js",
    "insights": "node --disable-warning=ExperimentalWarning dist/insights.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "digest": "node --disable-warning=ExperimentalWarning dist/digest.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
